// ----------------------------------------------------------------
// listedAsinGuard.ts — My Listings (store_catalog_state) ASIN lookup
// ----------------------------------------------------------------

import { query } from "../../db/client"
import { resolveListingAsin } from "../monitor/monitorService"

export type ListedAsinMatch = {
  asin:            string
  storeCode:        string
  ebayItemId:       string | null
  catalogStateId:   number
  currentStatus:    string
  title:            string | null
}

type CatalogRow = {
  catalog_state_id: number
  store_code:       string
  ebay_item_id:     string | null
  current_status:   string
  registry_asin:    string | null
  source_url:       string | null
  internal_sku:     string
  ebay_title:       string | null
}

/**
 * Returns first My Listings match per ASIN across all workspace stores.
 * ASIN resolution: registry → source_url → SKU parse (same as monitor).
 */
export async function findExistingListedAsins(
  workspaceId: string,
  asins:       string[]
): Promise<Map<string, ListedAsinMatch>> {
  const wanted = new Set(asins.map(a => a.trim().toUpperCase()).filter(Boolean))
  const out = new Map<string, ListedAsinMatch>()
  if (wanted.size === 0) return out

  const result = await query<CatalogRow>(
    `SELECT
       scs.id                    AS catalog_state_id,
       s.store_code,
       scs.ebay_item_id,
       scs.current_status::text  AS current_status,
       ar.asin                   AS registry_asin,
       scs.source_url,
       scs.internal_sku,
       scs.ebay_title
     FROM store_catalog_state scs
     INNER JOIN stores s ON s.id = scs.store_id
     LEFT JOIN asin_registry ar ON ar.id = scs.asin_registry_id
     WHERE scs.workspace_id = $1`,
    [workspaceId]
  )

  for (const row of result.rows) {
    const resolved = resolveListingAsin({
      registryAsin: row.registry_asin,
      sourceUrl:    row.source_url,
      internalSku:  row.internal_sku,
    })
    if (!resolved || !wanted.has(resolved)) continue
    if (out.has(resolved)) continue

    out.set(resolved, {
      asin:          resolved,
      storeCode:     row.store_code,
      ebayItemId:    row.ebay_item_id,
      catalogStateId: row.catalog_state_id,
      currentStatus: row.current_status,
      title:         row.ebay_title,
    })
  }

  return out
}
