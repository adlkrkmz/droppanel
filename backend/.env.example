# Environment template — eBay / ListJetGo backend
# Copy to .env and fill secrets. Never commit real .env.
#
# Etsy OAuth docs: docs/ETSY_OAUTH_ENV.md
# Standalone Etsy project (different repo path) uses its own .env — do not mix.

# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/droppanel
WORKSPACE_ID=00000000-0000-0000-0000-000000000001
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://panel.listjetgo.com
TRUST_PROXY_HOPS=0
# Production Chrome Web Store companion (CORS + CSRF origin allowlist).
# Use the published item ID only — do not allow all chrome-extension:// origins.
# CHROME_EXTENSION_IDS=cfjinofglmlecbhocckbbfeagppnlbpf

# --- eBay OAuth (/admin/ebay/*) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://api.listjetgo.com/admin/ebay/callback
# Public HTTPS endpoint eBay Notification API will challenge (GET ?challenge_code=) and POST events to.
EBAY_NOTIFICATION_ENDPOINT=https://api.listjetgo.com/webhooks/ebay-notifications
# Non-secret Notification API config (PUT /commerce/notification/v1/config alertEmail).
EBAY_NOTIFICATION_ALERT_EMAIL=app.listjetgo@gmail.com
# User panel OAuth (/app/ebay/*) — add this exact URL to eBay Developer Console RuName/redirect list
EBAY_USER_REDIRECT_URI=http://localhost:4000/app/ebay/callback
# HMAC secret for signed user OAuth state (defaults to AUTH_JWT_SECRET if unset)
EBAY_OAUTH_STATE_SECRET=
EBAY_SANDBOX=false
EBAY_SIMULATION=false
EBAY_RUNAME=

# Server-owned eBay mutation gates. Keep automatic zero and price updates closed until reviewed.
EBAY_LIVE_QUANTITY_MUTATION_SOURCES=manual_listing,sold_item_restock
EBAY_LIVE_MANUAL_END_ENABLED=false

# --- Etsy OAuth Connection Manager (/api/etsy/*) ---
# ETSY_CLIENT_ID = app Keystring (NOT the shared secret).
# Open API v3 x-api-key header = keystring:shared_secret (see etsyApiClient.ts).
# Production (register exact callback in Etsy Developer app):
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=https://api.listjetgo.com/api/etsy/callback
# Standalone Etsy frontend (etsy.listjetgo.com / local :3010) — not eBay panel
ETSY_AUTH_SUCCESS_REDIRECT=https://etsy.listjetgo.com/settings?etsy=connected
ETSY_AUTH_ERROR_REDIRECT=https://etsy.listjetgo.com/settings?etsy=error
ETSY_SCOPES=shops_r listings_r listings_w transactions_r profile_r
# 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Local dev overrides (shared API :4000 + Etsy web :3010) ---
# ETSY_REDIRECT_URI=http://localhost:4000/api/etsy/callback
# ETSY_AUTH_SUCCESS_REDIRECT=http://localhost:3010/settings?etsy=connected
# ETSY_AUTH_ERROR_REDIRECT=http://localhost:3010/settings?etsy=error

# --- Auth (Phase 1 — user register / JWT) ---
AUTH_JWT_SECRET=change-me-in-production-use-long-random-string
AUTH_COOKIE_NAME=listjetgo_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=listjetgo_session
SESSION_RETENTION_DAYS=30
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# GIS (Google Identity Services) ID-token flow uses CLIENT_ID only — no client secret required.
# If you later add authorization-code exchange, set GOOGLE_CLIENT_SECRET as well.
# GOOGLE_CLIENT_SECRET=
# Store-bound Gmail mailbox (authorization-code, not GIS login).
# Same GOOGLE_CLIENT_ID Web client. Requires GOOGLE_CLIENT_SECRET.
# Authorized redirect URI in Google Cloud Console must match exactly:
# GOOGLE_CLIENT_SECRET=
# GOOGLE_MAILBOX_REDIRECT_URI=https://api.listjetgo.com/app/mailbox/callback
# GOOGLE_MAILBOX_STATE_SECRET=
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- SMTP (Gmail / transactional mail — forgot password) ---
# Production example (Gmail app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=
# MAIL_FROM="ListJetGo <your@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Panel → backend admin user approval proxy (must match panel ADMIN_INTERNAL_API_KEY)
ADMIN_INTERNAL_API_KEY=local-dev-admin-internal-key
# Production: use a high-entropy ADMIN_INTERNAL_API_KEY. Loopback-only internal
# automation is deliberately disabled when NODE_ENV=production.

# --- Panel admin login (Next.js /api/auth/login — unchanged) ---
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# --- Other services ---
GEMINI_API_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Keepa (Phase 1) ---
KEEPA_API_KEY=
KEEPA_DOMAIN=1
KEEPA_ENABLED=true
KEEPA_DIRECT_MUTATIONS_ENABLED=false
KEEPA_COLLECTOR_PROTOCOL_ENABLED=false
KEEPA_DRY_RUN=true
KEEPA_OFFERS_ENABLED=false

# Global Keepa monitor foundation (Phase 1). Defaults must stay false.
# Not wired to Stock Guard / eBay mutations. Do not enable in production yet.
GLOBAL_KEEPA_MONITOR_ENABLED=false
GLOBAL_KEEPA_ACTIONS_ENABLED=false
GLOBAL_KEEPA_PLANNER_ENABLED=false
GLOBAL_KEEPA_SHADOW_MODE=true
GLOBAL_EXTENSION_VERIFICATION_ENABLED=false
# Legacy name: gates Keepa → amazon_price_verification_tasks (server Amazon Worker enqueue).
# Extension claim stays off when GLOBAL_SERVER_BROWSER_PRIMARY=true and FALLBACK=false.
GLOBAL_KEEPA_TO_EXTENSION_DISPATCH_ENABLED=false
GLOBAL_EXTENSION_APPLY_SOURCE_PRICE=false
VERIFIED_STOCK_ACTIONS_ENABLED=false
ACTIVITY_CENTER_ENABLED=false
GLOBAL_SERVER_BROWSER_VERIFICATION_ENABLED=true
GLOBAL_SERVER_BROWSER_PRIMARY=true
GLOBAL_EXTENSION_VERIFICATION_FALLBACK=false
# AMAZON_BROWSER_PROFILE_DIR=./var/amazon-browser-profile
# AMAZON_BROWSER_HEADLESS=false
# AMAZON_BROWSER_CONCURRENCY=1
# AMAZON_BROWSER_PACE_MS=5000
# EXTENSION_HEARTBEAT_INTERVAL_SECONDS=30
# EXTENSION_WORKER_OFFLINE_AFTER_SECONDS=90
# AMAZON_VERIFICATION_LEASE_SECONDS=120
# MAX_CONCURRENT_VERIFICATION_TASKS_PER_WORKER=1
# KEEPA_FALLBACK_MAX_TASKS_PER_MINUTE=20
# KEEPA_FALLBACK_MAX_PENDING_TASKS=400
# GLOBAL_KEEPA_PRODUCT_BATCH_MAX=100
# GLOBAL_KEEPA_TOKEN_COST_PER_ASIN=1
# GLOBAL_KEEPA_SOLD_MIN_RECHECK_HOURS=12
# GLOBAL_KEEPA_CLICKED_MIN_RECHECK_HOURS=24
# GLOBAL_KEEPA_NORMAL_MIN_RECHECK_HOURS=36
# GLOBAL_KEEPA_HARD_MAX_CHECK_AGE_HOURS=24
# GLOBAL_KEEPA_TARGET_MAX_CAPACITY_UTILIZATION=0.95
# GLOBAL_KEEPA_CAPACITY_TARGET_PERCENT=95
# GLOBAL_KEEPA_TOKEN_RESERVE=100
# GLOBAL_KEEPA_SAFE_UTILIZATION=0.95
# GLOBAL_KEEPA_CLAIM_LEASE_SECONDS=90
# GLOBAL_KEEPA_TICK_INTERVAL_MS=60000

# Private ChatGPT Developer Mode MCP connection.
# Keep false unless actively testing through an HTTPS tunnel.
# Never enable unauthenticated MCP in production (NODE_ENV=production blocks mount).
CHATGPT_APP_MCP_ENABLED=false

# ChatGPT App Etsy read tools reuse the same private-dev workspace as Etsy HTTP routes.
# WORKSPACE_ID must be set (see Core section). Tools never accept workspaceId from ChatGPT input.
# If WORKSPACE_ID is missing/invalid, Etsy read tools return CHATGPT_APP_WORKSPACE_NOT_CONFIGURED
# and do not query the database or auto-select a workspace.

# Keepa change-sensor collector (scraper host only; leave disabled).
# Do not put DATABASE_URL or eBay credentials on the scraper.
# LISTJETGO_API_BASE=
# KEEPA_COLLECTOR_WORKER_TOKEN=
# KEEPA_API_KEY=
# KEEPA_LOCAL_DB_PATH=/var/lib/listjetgo-scan/keepa/keepa-worker.sqlite
# KEEPA_COLLECTOR_BATCH_SIZE=20
# KEEPA_COLLECTOR_POLL_MS=15000
# KEEPA_COLLECTOR_BATCH_GAP_MS=800
# KEEPA_SOLD_CADENCE_HOURS=12
# KEEPA_STANDARD_CADENCE_HOURS=24
# KEEPA_VERIFY_RETRY_COOLDOWN_MS=21600000
# KEEPA_COLLECTOR_ENABLED=false
# KEEPA_COLLECTOR_PROTOCOL_ENABLED=false
# KEEPA_COLLECTOR_RUN_MODE=bootstrap-only
# KEEPA_COLLECTOR_MAX_BATCHES=1
# KEEPA_COLLECTOR_BOOTSTRAP_PAGE_SIZE=200
# KEEPA_COLLECTOR_CATCHUP_MAX_ROUNDS=8
# KEEPA_VERIFY_CLAIM_ENABLED=false
# KEEPA_DIRECT_MUTATIONS_ENABLED=false

