import { NextRequest, NextResponse } from 'next/server'
import { loadEnvConfig } from '@next/env'
import fs from 'fs'
import path from 'path'
import {
  USER_SESSION_COOKIE,
  clearAuthCookies,
  cookieSecure,
  panelApiBase,
} from '@/lib/panelAuthServer'

loadEnvConfig(path.join(process.cwd()), process.env.NODE_ENV !== 'production')

function readEnvLocalText(envPath: string): string {
  const buf = fs.readFileSync(envPath)
  if (buf.length >= 2 && buf[0] === 0xff && buf[1] === 0xfe) {
    return buf.toString('utf16le')
  }
  if (buf.length >= 4 && buf[1] === 0 && buf[3] === 0) {
    return buf.toString('utf16le')
  }
  return buf.toString('utf8')
}

function readAdminFromEnvFile(): { user?: string; pass?: string } {
  const envPath = path.join(process.cwd(), '.env.local')
  if (!fs.existsSync(envPath)) return {}

  const lines = readEnvLocalText(envPath).split(/\r?\n/)
  let user: string | undefined
  let pass: string | undefined
  for (const line of lines) {
    if (line.startsWith('ADMIN_USERNAME=')) {
      user = line.slice('ADMIN_USERNAME='.length).trim()
    }
    if (line.startsWith('ADMIN_PASSWORD=')) {
      pass = line.slice('ADMIN_PASSWORD='.length).trim()
    }
  }
  return { user, pass }
}

function resolveAdminCredentials(): { user?: string; pass?: string } {
  const user = process.env.ADMIN_USERNAME?.trim()
  const pass = process.env.ADMIN_PASSWORD
  if (user && pass) return { user, pass }
  return readAdminFromEnvFile()
}

type BackendLoginResult =
  | { ok: true; token: string }
  | { ok: false; blocked: true; status: string; message: string }
  | { ok: false; blocked: false; message: string }

async function tryBackendUserLogin(
  email: string,
  password: string
): Promise<BackendLoginResult> {
  const res = await fetch(`${panelApiBase()}/auth/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password }),
    cache: 'no-store',
  })

  const data = await res.json().catch(() => ({}))
  if (res.status === 403 && data.status) {
    return {
      ok: false,
      blocked: true,
      status: String(data.status),
      message: String(data.message || 'Sign in blocked'),
    }
  }
  if (!res.ok) {
    return {
      ok: false,
      blocked: false,
      message: String(data.error || data.message || 'Invalid email or password'),
    }
  }
  if (!data.token) {
    return { ok: false, blocked: false, message: 'Invalid email or password' }
  }
  return { ok: true, token: String(data.token) }
}

export async function POST(request: NextRequest) {
  let identifier = ''
  try {
    const body = await request.json()
    identifier = String(body?.username ?? body?.email ?? '').trim()
    const password = String(body?.password ?? '')

    const { user: adminUser, pass: adminPass } = resolveAdminCredentials()

    console.log(`[Auth] POST /api/auth/login attempt identifier=${identifier || '(empty)'}`)

    if (!identifier || !password) {
      return NextResponse.json({ error: 'Email and password are required' }, { status: 400 })
    }

    if (adminUser && adminPass && identifier === adminUser && password === adminPass) {
      console.log(`[Auth] admin login success username=${identifier}`)
      const response = NextResponse.json({ ok: true, kind: 'admin' })
      clearAuthCookies(response)
      response.cookies.set('admin_session', 'authenticated', {
        httpOnly: true,
        sameSite: 'lax',
        secure: cookieSecure(),
        path: '/',
        maxAge: 60 * 60 * 24 * 7,
      })
      return response
    }

    const email = identifier.toLowerCase()
    const userResult = await tryBackendUserLogin(email, password)
    if (userResult.ok === false && userResult.blocked) {
      console.log(`[Auth] user login blocked email=${email} status=${userResult.status}`)
      return NextResponse.json(
        {
          ok: false,
          blocked: true,
          status: userResult.status,
          message: userResult.message,
        },
        { status: 403 }
      )
    }
    if (userResult.ok === false) {
      console.log(`[Auth] user login rejected email=${email}`)
      return NextResponse.json({ error: 'Invalid email or password' }, { status: 401 })
    }

    console.log(`[Auth] user login success email=${email}`)
    const response = NextResponse.json({ ok: true, kind: 'user' })
    clearAuthCookies(response)
    response.cookies.set(USER_SESSION_COOKIE, userResult.token, {
      httpOnly: true,
      sameSite: 'lax',
      secure: cookieSecure(),
      path: '/',
      maxAge: 60 * 60 * 24 * 7,
    })
    return response
  } catch (e) {
    console.error('[Auth] login handler error:', e)
    return NextResponse.json({ error: 'Invalid request body' }, { status: 400 })
  }
}
