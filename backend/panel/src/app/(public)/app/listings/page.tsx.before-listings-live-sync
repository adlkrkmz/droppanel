          </button>
          {needsAsin && item.ebayItemId && canAsinModal && (
            <button type="button" onClick={onOpenAsinModal} style={actionBtnStyle}>
              Link ASIN
            </button>
          )}
          {needsAsin && item.ebayItemId && (
            <Link href={importAsinHref} style={{ ...linkAsinBtnStyle, fontSize: 11 }}>
              Bulk ASIN match
            </Link>
          )}
          {asinLinked && canAsinModal && (
            <button type="button" onClick={onOpenAsinModal} style={actionBtnStyle}>
