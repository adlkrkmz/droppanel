{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "exclude": [
    "_archived_scripts",
    "**/_archived_scripts/**",
    "panel",
    "panel/**",
    "dist"
  ]
}