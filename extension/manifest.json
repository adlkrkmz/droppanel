{
  "manifest_version": 3,
  "name": "DropPanel",
  "version": "1.1.0",
  "description": "DropPanel Amazon scraper and worker",
  "permissions": ["tabs", "storage", "scripting", "alarms", "activeTab"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "http://localhost:4000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/dp/*", "https://www.amazon.com/*/dp/*", "https://www.amazon.com/gp/product/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.amazon.com/s*", "https://www.amazon.com/*/s*"],
      "js": ["amazonSearch.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["panelBridge.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
